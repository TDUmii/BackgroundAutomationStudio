<Window x:Class="BackgroundAutomationStudio.ClickRepeaterMini.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Background Automation One Click Mini" Icon="Assets/app-icon.ico" Width="700" Height="650" MinWidth="620" MinHeight="590" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TitleText" Text="One Click Mini" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Focus one target and repeat one point with the physical mouse." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,5,12,0"/></StackPanel><ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="LanguageBox_SelectionChanged" SelectedIndex="0" AutomationProperties.Name="Interface language"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="vi" Content="Tiếng Việt"/></ComboBox></Grid>
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TargetLabel" Text="TARGET WINDOW" Foreground="{StaticResource TextSecondary}" FontSize="11"/><ComboBox x:Name="WindowBox" ItemsSource="{Binding Windows}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedWindow}" Margin="0,6,10,0" AutomationProperties.Name="Target window"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Bottom"/></Grid></Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X" Foreground="{StaticResource TextSecondary}"/><TextBox x:Name="XBox" Text="0" Margin="0,5,0,0" AutomationProperties.Name="Client X coordinate"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y" Foreground="{StaticResource TextSecondary}"/><TextBox x:Name="YBox" Text="0" Margin="0,5,0,0" AutomationProperties.Name="Client Y coordinate"/></StackPanel><Button x:Name="PickButton" Grid.Column="4" Content="Pick point" Click="PickButton_Click" VerticalAlignment="Bottom"/><TextBlock x:Name="PointHelp" Grid.Row="1" Grid.ColumnSpan="5" Text="Coordinates stay relative to the selected window when it moves." Foreground="{StaticResource TextSecondary}" Margin="0,9,0,0"/></Grid></Border>
        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="IntervalLabel" Text="INTERVAL (MS)" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBox x:Name="IntervalBox" Text="500" Margin="0,5,0,0" AutomationProperties.Name="Click interval in milliseconds"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="CountLabel" Text="REPEAT COUNT" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBox x:Name="CountBox" Text="100" Margin="0,5,0,0" AutomationProperties.Name="Repeat count"/></StackPanel><StackPanel Grid.Column="4"><TextBlock x:Name="PressLabel" Text="PRESS (MS)" Foreground="{StaticResource TextSecondary}" FontSize="11"/><TextBox x:Name="PressBox" Text="45" Margin="0,5,0,0" AutomationProperties.Name="Physical mouse press duration"/><CheckBox x:Name="InfiniteBox" Content="Run until stopped" Margin="0,12,0,0" Checked="InfiniteBox_Changed" Unchecked="InfiniteBox_Changed"/></StackPanel></Grid></Border>
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="RunStateText" Text="Ready" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Run status"/><TextBlock x:Name="ProgressText" Text="Choose a target and point" Foreground="{StaticResource TextSecondary}" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Run progress"/></StackPanel>
        <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="CompatibilityText" Text="Foreground only. This tool focuses the target and moves your physical pointer." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="RunButton" Grid.Column="1" Content="Start" Style="{StaticResource PrimaryButton}" Click="RunButton_Click"/></Grid>
    </Grid>
</Window>
