<Window x:Class="BackgroundAutomationStudio.RecorderMini.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Background Automation Recorder Mini" Icon="Assets/app-icon.ico" Width="820" Height="650" MinWidth="700" MinHeight="560" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TitleText" Text="Recorder Mini" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Capture actions from one selected window and export a portable JSON recording." Foreground="{StaticResource TextSecondary}" Margin="0,5,12,0"/></StackPanel><ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="LanguageBox_SelectionChanged" SelectedIndex="0" AutomationProperties.Name="Interface language"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="vi" Content="Tiếng Việt"/></ComboBox></Grid>
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TargetLabel" Text="TARGET WINDOW" Foreground="{StaticResource TextSecondary}" FontSize="11"/><ComboBox x:Name="WindowBox" ItemsSource="{Binding Windows}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedWindow}" Margin="0,6,10,0" AutomationProperties.Name="Target window"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Bottom"/></Grid></Border>
        <Border x:Name="RecordingBanner" Grid.Row="2" Background="#2A1A1E" BorderBrush="#6C343B" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Recording active"><DockPanel><TextBlock x:Name="TimerText" DockPanel.Dock="Right" Text="00:00:00" FontFamily="Consolas"/><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0"/><TextBlock x:Name="RecordingText" Text="RECORDING" Foreground="#FFB8BE" FontWeight="Bold"/></StackPanel></DockPanel></Border>
        <Grid Grid.Row="3" Margin="0,14,0,0"><ListBox x:Name="StepsList" ItemsSource="{Binding Steps}" AutomationProperties.Name="Recorded actions"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Column="1" Text="{Binding Summary}"/><TextBlock Grid.Column="2" Text="{Binding DelayMilliseconds, StringFormat={}{0} ms}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate><ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="AlternationCount" Value="100000"/></Style></ListBox.Style></ListBox><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock x:Name="EmptyTitle" Text="No actions recorded" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHelp" Text="Choose a target, start recording, then work inside that window." Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Recorder status"/><Button x:Name="ClearButton" Grid.Column="1" Content="Clear" Click="ClearButton_Click"/><Button x:Name="ExportButton" Grid.Column="3" Content="Export" Click="ExportButton_Click"/><Button x:Name="RecordButton" Grid.Column="5" Content="Start recording" Style="{StaticResource PrimaryButton}" Click="RecordButton_Click"/></Grid>
    </Grid>
</Window>
