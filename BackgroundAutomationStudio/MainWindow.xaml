<Window x:Class="BackgroundAutomationStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:BackgroundAutomationStudio.Infrastructure" Title="Background Automation Studio" Icon="Assets/app-icon.ico" Width="1280" Height="820" MinWidth="1024" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Window.InputBindings><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/><KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/><KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/><KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/></Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/><infra:OneBasedIndexConverter x:Key="OneBasedIndex"/><infra:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibility"/>
        <Style x:Key="LabelText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBackground}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
        <Style x:Key="TopMenuButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="14,0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#252A33"/></Trigger></Style.Triggers></Style>
        <Style x:Key="LeftScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#596273" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="{StaticResource PanelBackground}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="FileMenuButton" Content="{DynamicResource MenuFile}" Style="{StaticResource TopMenuButton}" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Placement="Bottom"><MenuItem Header="{DynamicResource NewProject}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/><MenuItem Header="{DynamicResource Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/><Separator/><MenuItem Header="{DynamicResource Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/><MenuItem Header="{DynamicResource SaveAs}" Command="{Binding SaveAsCommand}"/></ContextMenu></Button.ContextMenu></Button>
                <Button x:Name="EditMenuButton" Content="{DynamicResource MenuEdit}" Style="{StaticResource TopMenuButton}" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Placement="Bottom"><MenuItem Header="{DynamicResource Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/><MenuItem Header="{DynamicResource Redo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/><Separator/><MenuItem Header="{DynamicResource EditAction}" Command="{Binding EditCommand}"/><MenuItem Header="{DynamicResource DuplicateAction}" Command="{Binding DuplicateCommand}"/><MenuItem Header="{DynamicResource DeleteAction}" Command="{Binding DeleteCommand}"/><MenuItem Header="{DynamicResource ClearAll}" Command="{Binding ClearAllCommand}"/><Separator/><MenuItem Header="{DynamicResource MoveUp}" Command="{Binding MoveUpCommand}"/><MenuItem Header="{DynamicResource MoveDown}" Command="{Binding MoveDownCommand}"/></ContextMenu></Button.ContextMenu></Button>
                <Button x:Name="HotkeyButton" Style="{StaticResource TopMenuButton}" Click="HotkeyButton_Click"><StackPanel Orientation="Horizontal"><Path Data="M3,5 L21,5 M3,12 L21,12 M3,19 L21,19 M7,2 L7,8 M16,9 L16,15 M10,16 L10,22" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock x:Name="HotkeyText" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource TopMenuButton}" Click="SettingsButton_Click"><StackPanel Orientation="Horizontal"><Path Data="M12,3 A2,2 0 1 0 12,7 A2,2 0 1 0 12,3 M5,12 A2,2 0 1 0 5,16 A2,2 0 1 0 5,12 M18,12 A2,2 0 1 0 18,16 A2,2 0 1 0 18,12 M3,5 L10,5 M14,5 L21,5 M3,14 L3,14 M7,14 L16,14 M20,14 L21,14" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource MenuSettings}" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,0"><TextBlock Text="Background Automation Studio" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#252A33" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource VersionLabel}" FontSize="11" Foreground="{StaticResource TextSecondary}"/></Border></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LeftScrollBar}"/></ScrollViewer.Resources><Grid Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Panel}"><StackPanel>
                    <DockPanel><TextBlock Text="{DynamicResource TargetWindow}" FontSize="19" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" Background="#243047" CornerRadius="10" Padding="8,3"><TextBlock Text="{DynamicResource ClientCoordinates}" FontSize="9" Foreground="#AFC9FF"/></Border></DockPanel>
                    <TextBlock Text="{DynamicResource TargetHelp}" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,16"/><Button Content="{DynamicResource SelectWindow}" Style="{StaticResource PrimaryButton}" Command="{Binding SelectWindowCommand}"/>
                    <Border Background="#111419" CornerRadius="8" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock Text="{DynamicResource Application}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Project.Target.ProcessName, FallbackValue=-, TargetNullValue=-}" FontWeight="SemiBold" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{DynamicResource WindowTitle}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Project.Target.WindowTitle, FallbackValue=-, TargetNullValue=-}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HWND" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Project.Target.HwndDisplay, FallbackValue=-, TargetNullValue=-}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Class}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Project.Target.WindowClassName, FallbackValue=-, TargetNullValue=-}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></StackPanel></Border>
                    <TextBlock Text="{DynamicResource RecordedLayout}" Style="{StaticResource LabelText}" Margin="0,14,0,4"/><TextBlock Text="{Binding Project.Target.LayoutDisplay, FallbackValue=-, TargetNullValue=-}" FontWeight="SemiBold"/>
                </StackPanel></Border>
                <Border Grid.Row="2" Style="{StaticResource Panel}"><StackPanel>
                    <TextBlock Text="{DynamicResource CapturePlayback}" FontSize="19" FontWeight="SemiBold"/>
                    <Border Background="#2A1A1E" BorderBrush="#6C343B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RecordingTime}" FontFamily="Consolas" Foreground="#FFD8DB"/><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Recording}" Foreground="#FF929B" FontWeight="Bold"/></StackPanel></DockPanel></Border>
                    <TextBlock Text="{DynamicResource RepeatMode}" Style="{StaticResource LabelText}" Margin="0,12,0,5"/>
                    <ComboBox SelectedValue="{Binding RepeatMode, Mode=TwoWay}" SelectedValuePath="Tag" MinHeight="38" AutomationProperties.Name="Run schedule">
                        <ComboBoxItem Tag="Count" Content="{DynamicResource RepeatCountMode}"/><ComboBoxItem Tag="Infinite" Content="{DynamicResource RepeatInfiniteMode}"/><ComboBoxItem Tag="Duration" Content="{DynamicResource RepeatDurationMode}"/><ComboBoxItem Tag="UntilTime" Content="{DynamicResource RepeatUntilTimeMode}"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource RepeatCount}" Margin="0,10,0,5"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="Count"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=LostFocus}" MinHeight="38" FontFamily="Consolas" AutomationProperties.Name="Repeat count"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="Count"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                    <TextBlock Text="{DynamicResource DurationMinutes}" Margin="0,10,0,5"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="Duration"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBox Text="{Binding RepeatDurationMinutes, UpdateSourceTrigger=LostFocus}" MinHeight="38" FontFamily="Consolas" AutomationProperties.Name="Run duration in minutes"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="Duration"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                    <TextBlock Text="{DynamicResource StopAtTime}" Margin="0,10,0,5"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="UntilTime"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBox Text="{Binding StopAtTime, UpdateSourceTrigger=LostFocus}" MinHeight="38" FontFamily="Consolas" AutomationProperties.Name="Stop at time"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="UntilTime"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                    <TextBlock Text="{DynamicResource InfiniteHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RepeatMode}" Value="Infinite"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock Text="{DynamicResource RepeatHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="{DynamicResource Record}" Command="{Binding StartRecordCommand}" Margin="0,0,5,8"/><Button Content="{DynamicResource StopRecord}" Command="{Binding StopRecordCommand}" Margin="5,0,0,8" Style="{StaticResource DangerButton}"/><Button Content="{DynamicResource CancelRecord}" Command="{Binding CancelRecordCommand}" Margin="0,0,5,0"/><Button Content="{DynamicResource RunWorkflow}" Command="{Binding RunCommand}" Margin="5,0,0,0" Style="{StaticResource PrimaryButton}"/></UniformGrid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" Margin="0,0,5,0"/><Button Grid.Column="1" Content="{DynamicResource StopRun}" Command="{Binding StopRunCommand}" Margin="5,0,0,0"/></Grid>
                </StackPanel></Border>
                <Border Grid.Row="4" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="{DynamicResource Project}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding ProjectTitle}" FontSize="16" Margin="0,10,0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{DynamicResource ModifiedHelp}" Foreground="{StaticResource TextSecondary}"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource Open}" Command="{Binding OpenCommand}" Margin="0,0,5,0"/><Button Grid.Column="1" Content="{DynamicResource Save}" Command="{Binding SaveCommand}" Margin="5,0,0,0"/></Grid></StackPanel></Border>
            </Grid></ScrollViewer>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="20,16,20,8"><StackPanel><TextBlock Text="{DynamicResource Workflow}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource WorkflowHelp}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{DynamicResource Undo}" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" Margin="0,0,8,0"/><Button Content="{DynamicResource Redo}" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y / Ctrl+Shift+Z" Margin="0,0,10,0"/><Button x:Name="AddActionButton" Content="{DynamicResource AddAction}" Style="{StaticResource PrimaryButton}" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Placement="Bottom"><MenuItem Header="{DynamicResource Click}" Command="{Binding AddActionCommand}" CommandParameter="Click"/><MenuItem Header="{DynamicResource RightClick}" Command="{Binding AddActionCommand}" CommandParameter="RightClick"/><MenuItem Header="{DynamicResource DoubleClick}" Command="{Binding AddActionCommand}" CommandParameter="DoubleClick"/><Separator/><MenuItem Header="{DynamicResource TypeText}" Command="{Binding AddActionCommand}" CommandParameter="TypeText"/><MenuItem Header="{DynamicResource KeyPress}" Command="{Binding AddActionCommand}" CommandParameter="KeyPress"/><MenuItem Header="{DynamicResource Wait}" Command="{Binding AddActionCommand}" CommandParameter="Wait"/></ContextMenu></Button.ContextMenu></Button></StackPanel></DockPanel>
                <TabControl Grid.Row="1" Margin="12,0,12,12"><TabItem Header="{DynamicResource VisualEditor}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="WorkflowList" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Background="Transparent" BorderThickness="0" AllowDrop="True" AlternationCount="100000" PreviewMouseLeftButtonDown="WorkflowList_PreviewMouseLeftButtonDown" MouseMove="WorkflowList_MouseMove" Drop="WorkflowList_Drop" MouseDoubleClick="WorkflowList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border x:Name="Row" Background="#1D2128" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="32"/><ColumnDefinition Width="34"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Grid.Column="0" Data="M0,0 L8,5 L0,10 Z" Fill="#AFC9FF" Width="8" Height="10" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/><TextBlock Grid.Column="1" Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndex}}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/><CheckBox Grid.Column="2" IsChecked="{Binding Enabled}"/><TextBlock Grid.Column="3" Text="{Binding ActionType}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="5" Text="{DynamicResource Current}" Foreground="#AFC9FF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/></Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.46"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="Row" Property="Background" Value="#292F39"/><Setter TargetName="Row" Property="BorderBrush" Value="#6E798A"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsKeyboardFocusWithin}" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#9EC0FF"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></DataTrigger><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Row" Property="Background" Value="#1D355D"/><Setter TargetName="Row" Property="BorderBrush" Value="#5A8FE4"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="{DynamicResource Edit}" Command="{Binding EditCommand}"/><MenuItem Header="{DynamicResource Duplicate}" Command="{Binding DuplicateCommand}"/><MenuItem Header="{DynamicResource Delete}" Command="{Binding DeleteCommand}"/><Separator/><MenuItem Header="{DynamicResource MoveUp}" Command="{Binding MoveUpCommand}"/><MenuItem Header="{DynamicResource MoveDown}" Command="{Binding MoveDownCommand}"/></ContextMenu></ListBox.ContextMenu>
                    </ListBox>
                    <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False" Visibility="{Binding Actions.Count, Converter={StaticResource EmptyCollectionToVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390"><TextBlock Text="{DynamicResource NoActions}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource NoActionsHelp}" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                    <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False"><Button DockPanel.Dock="Left" Content="{DynamicResource ClearAll}" Command="{Binding ClearAllCommand}" Style="{StaticResource DangerButton}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource Edit}" Command="{Binding EditCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource Duplicate}" Command="{Binding DuplicateCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource Delete}" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource MoveUp}" Command="{Binding MoveUpCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource MoveDown}" Command="{Binding MoveDownCommand}"/></StackPanel></DockPanel>
                </Grid></TabItem>
                <TabItem Header="{DynamicResource ScriptEditor}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource ScriptHelp}" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,10"/><TextBox Grid.Row="1" Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="16" SpellCheck.IsEnabled="False"/><Border Grid.Row="2" Background="#2A1A1E" BorderBrush="#6C343B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ScriptErrors}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ScriptErrors}" Foreground="#FFB8BE" FontFamily="Consolas"/></Border></Grid></TabItem></TabControl>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#0C0E11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="{DynamicResource BackgroundMode}" Foreground="#8792A3" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel></Border>
    </Grid>
</Window>
