                    <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False"><Button DockPanel.Dock="Left" Content="{DynamicResource ClearAll}" Command="{Binding ClearAllCommand}" Style="{StaticResource DangerButton}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource Edit}" Command="{Binding EditCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource Duplicate}" Command="{Binding DuplicateCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource Delete}" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource MoveUp}" Command="{Binding MoveUpCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource MoveDown}" Command="{Binding MoveDownCommand}"/></StackPanel></DockPanel>
                </Grid></TabItem>
                <TabItem Header="{DynamicResource ScriptEditor}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource ScriptHelp}" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,10"/><TextBox Grid.Row="1" Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="16" SpellCheck.IsEnabled="False"><TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></TextBox.Resources></TextBox><Border Grid.Row="2" Background="#2A1A1E" BorderBrush="#6C343B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ScriptErrors}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ScriptErrors}" Foreground="#FFB8BE" FontFamily="Consolas"/></Border></Grid></TabItem></TabControl>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="3" Background="#0C0E11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlaybackModeText" DockPanel.Dock="Right" Foreground="#AFC9FF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel></Border>
    </Grid>
</Window>
