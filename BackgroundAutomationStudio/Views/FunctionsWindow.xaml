<Window x:Class="BackgroundAutomationStudio.Views.FunctionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/BackgroundAutomationStudio;component/Assets/app-icon.ico" Title="{DynamicResource FunctionsTitle}" Width="650" Height="560" MinWidth="560" MinHeight="460" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{StaticResource AppBackground}" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><StackPanel><TextBlock Text="{DynamicResource FunctionsTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource FunctionsHelp}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" MaxWidth="520"/></StackPanel><Button DockPanel.Dock="Right" Content="{DynamicResource NewFunction}" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center"/></DockPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,20,0,0" Padding="8"><Grid><ListBox x:Name="FunctionsList" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0" MouseDoubleClick="FunctionsList_MouseDoubleClick"><ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ListBox.Resources><ListBox.ItemTemplate><DataTemplate><Border x:Name="FunctionRow" Background="#1D2128" CornerRadius="8" Padding="14,11" Margin="0,0,0,6"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding Actions.Count}" Foreground="#8792A3"/><TextBlock Text=" {DynamicResource StepsLabel}" Foreground="#8792A3"/></StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="FunctionRow" Property="Background" Value="#292F39"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"><TextBlock Text="{DynamicResource NoFunctions}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{DynamicResource NoFunctionsHelp}" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Border>
        <DockPanel Grid.Row="2" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Edit}" Click="Edit_Click" MinWidth="90"/><Button Content="{DynamicResource Delete}" Click="Delete_Click" Style="{StaticResource DangerButton}" MinWidth="90" Margin="10,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="90"/><Button Content="{DynamicResource ApplyFunctions}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="120" Margin="10,0,0,0" Click="Apply_Click"/></StackPanel></DockPanel>
    </Grid>
</Window>
