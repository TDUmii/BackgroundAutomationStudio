<Window x:Class="BackgroundAutomationStudio.Views.FunctionEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/BackgroundAutomationStudio;component/Assets/app-icon.ico" Title="{DynamicResource FunctionEditorTitle}" Width="620" Height="650" MinWidth="520" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Background="{StaticResource AppBackground}" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource FunctionEditorTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource FunctionEditorHelp}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="{DynamicResource FunctionName}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox x:Name="NameBox" MaxLength="60" AutomationProperties.Name="Reusable function name"/></StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource FunctionSteps}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox x:Name="ScriptBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="14" SpellCheck.IsEnabled="False" AutomationProperties.Name="Function workflow script"><TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></TextBox.Resources></TextBox></Grid>
        <Border x:Name="ErrorPanel" Grid.Row="3" Background="#2A1A1E" BorderBrush="#6C343B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="#FFB8BE" FontFamily="Consolas"/></Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,10,0"/><Button Content="{DynamicResource SaveFunction}" Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
