<Window x:Class="BackgroundAutomationStudio.Views.ActionEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:BackgroundAutomationStudio.Models" xmlns:infra="clr-namespace:BackgroundAutomationStudio.Infrastructure" Icon="/BackgroundAutomationStudio;component/Assets/app-icon.ico" Width="500" Height="700" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <infra:ActionTypeLocalizationConverter x:Key="ActionTypeLocalization"/>
        <infra:PngBytesToImageConverter x:Key="PngBytesToImage"/>
        <DataTemplate x:Key="ImageScanFields"><StackPanel>
            <TextBlock Text="{DynamicResource ImageTemplate}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Height="120" Background="#11151B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6"><Grid><Image Source="{Binding TemplatePng, Converter={StaticResource PngBytesToImage}}" Stretch="Uniform"/><TextBlock Text="{DynamicResource NoImageTemplate}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTemplate}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
            <TextBlock Text="{Binding TemplateName}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource ChoosePng}" Click="ChooseTemplate_Click"/><Button Grid.Column="2" Content="{DynamicResource ClearTemplate}" Click="ClearTemplate_Click"/></Grid>
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Similarity}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding SimilarityPercent, UpdateSourceTrigger=LostFocus}" Tag="PositiveInteger" AutomationProperties.Name="Image similarity percent"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource ImageTimeout}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Image scan timeout in milliseconds"/></StackPanel></Grid>
            <TextBlock Text="{DynamicResource PollInterval}" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,5"/><TextBox Text="{Binding PollIntervalMilliseconds, UpdateSourceTrigger=LostFocus}" Tag="PositiveInteger" AutomationProperties.Name="Image scan poll interval in milliseconds"/>
            <TextBlock Text="{DynamicResource SearchRegion}" FontWeight="SemiBold" Margin="0,16,0,7"/><UniformGrid Columns="4"><StackPanel Margin="0,0,5,0"><TextBlock Text="X" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding RegionX, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger"/></StackPanel><StackPanel Margin="5,0"><TextBlock Text="Y" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding RegionY, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger"/></StackPanel><StackPanel Margin="5,0"><TextBlock Text="W" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding RegionWidth, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="H" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding RegionHeight, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger"/></StackPanel></UniformGrid>
            <TextBlock Text="{DynamicResource ImageScanHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:WaitForImageAction}"><StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ImageScanFields}"/><CheckBox Content="{DynamicResource WaitForDisappear}" IsChecked="{Binding WaitForDisappear}" Margin="0,14,0,0"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:ClickImageAction}"><StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ImageScanFields}"/><CheckBox Content="{DynamicResource RightClickMatchedImage}" IsChecked="{Binding RightClick}" Margin="0,14,0,0"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource OffsetX}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding OffsetX, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Image click X offset"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource OffsetY}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding OffsetY, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Image click Y offset"/></StackPanel></Grid></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:PointerAction}"><StackPanel>
            <TextBlock Text="{DynamicResource ClientPoint}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource XCoordinate}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding ClientX, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="X coordinate in the target client area"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource YCoordinate}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding ClientY, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Y coordinate in the target client area"/></StackPanel></Grid>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource PickNewPoint}" Click="PickPoint_Click"/><Button Grid.Column="2" Content="{DynamicResource TestPoint}" Click="TestPoint_Click"/></Grid>
            <TextBlock Text="{DynamicResource CoordinateHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,9,0,0"/>
        </StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:TypeTextAction}"><StackPanel><TextBlock Text="{DynamicResource TextToType}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Text to type in the target"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:KeyPressAction}"><StackPanel><TextBlock Text="{DynamicResource KeyOrShortcut}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox IsEditable="True" Text="{Binding KeyName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Key or shortcut to press"><ComboBoxItem Content="ENTER"/><ComboBoxItem Content="TAB"/><ComboBoxItem Content="ESCAPE"/><ComboBoxItem Content="BACKSPACE"/><ComboBoxItem Content="DELETE"/><ComboBoxItem Content="UP"/><ComboBoxItem Content="DOWN"/><ComboBoxItem Content="LEFT"/><ComboBoxItem Content="RIGHT"/><ComboBoxItem Content="CTRL"/><ComboBoxItem Content="SHIFT"/><ComboBoxItem Content="ALT"/><ComboBoxItem Content="F1"/><ComboBoxItem Content="F2"/><ComboBoxItem Content="F3"/><ComboBoxItem Content="F4"/><ComboBoxItem Content="F5"/><ComboBoxItem Content="F6"/><ComboBoxItem Content="F7"/><ComboBoxItem Content="F8"/><ComboBoxItem Content="F9"/><ComboBoxItem Content="F10"/><ComboBoxItem Content="F11"/><ComboBoxItem Content="F12"/></ComboBox><TextBlock Text="{DynamicResource ShortcutHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:KeyHoldAction}"><StackPanel><TextBlock Text="{DynamicResource KeyHold}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource KeyOrShortcut}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><ComboBox IsEditable="True" Text="{Binding KeyName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Key or shortcut to hold"><ComboBoxItem Content="E"/><ComboBoxItem Content="W"/><ComboBoxItem Content="A"/><ComboBoxItem Content="S"/><ComboBoxItem Content="D"/><ComboBoxItem Content="SPACE"/><ComboBoxItem Content="SHIFT"/><ComboBoxItem Content="CTRL"/></ComboBox><TextBlock Text="{DynamicResource HoldDuration}" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,5"/><TextBox Text="{Binding Milliseconds, UpdateSourceTrigger=LostFocus}" Tag="PositiveInteger" AutomationProperties.Name="Held-key duration in milliseconds"/><TextBlock Text="{DynamicResource HoldHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:DragAction}"><StackPanel><TextBlock Text="{DynamicResource Drag}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="{DynamicResource StartX}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding StartX, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Drag start X coordinate in the target client area"/></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="{DynamicResource StartY}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding StartY, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Drag start Y coordinate in the target client area"/></StackPanel><StackPanel Margin="0,0,6,8"><TextBlock Text="{DynamicResource EndX}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding EndX, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Drag end X coordinate in the target client area"/></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="{DynamicResource EndY}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding EndY, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Drag end Y coordinate in the target client area"/></StackPanel></UniformGrid><TextBlock Text="{DynamicResource HoldDuration}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,5"/><TextBox Text="{Binding Milliseconds, UpdateSourceTrigger=LostFocus}" Tag="PositiveInteger" AutomationProperties.Name="Drag duration in milliseconds"/><TextBlock Text="{DynamicResource DragHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:ScrollAction}"><StackPanel><TextBlock Text="{DynamicResource Scroll}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource XCoordinate}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding ClientX, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Scroll X coordinate in the target client area"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource YCoordinate}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding ClientY, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Scroll Y coordinate in the target client area"/></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource PickNewPoint}" Click="PickPoint_Click"/><Button Grid.Column="2" Content="{DynamicResource TestPoint}" Click="TestPoint_Click"/></Grid><TextBlock Text="{DynamicResource WheelDelta}" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,5"/><TextBox Text="{Binding Delta, UpdateSourceTrigger=LostFocus}" Tag="NonZeroInteger" AutomationProperties.Name="Mouse wheel delta"/><TextBlock Text="{DynamicResource ScrollHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:CallFunctionAction}"><StackPanel><TextBlock Text="{DynamicResource CallFunction}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource FunctionToCall}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding AvailableFunctions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FunctionId}" AutomationProperties.Name="Reusable function to call"/><TextBlock Text="{DynamicResource CallFunctionHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type models:WaitAction}"><StackPanel><TextBlock Text="{DynamicResource WaitDuration}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource Milliseconds}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding Milliseconds, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Wait duration in milliseconds"/><TextBlock Text="{DynamicResource MillisecondHelp}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,0"/></StackPanel></DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackground}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding ActionType, Converter={StaticResource ActionTypeLocalization}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource EditActionHelp}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,20,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding}" Margin="0,0,8,0"/></ScrollViewer></Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource DelayBefore}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding DelayBefore, UpdateSourceTrigger=LostFocus}" Tag="NonNegativeInteger" AutomationProperties.Name="Delay before action in milliseconds"/></StackPanel><CheckBox Grid.Column="2" Content="{DynamicResource ActionEnabled}" IsChecked="{Binding Enabled}" VerticalAlignment="Bottom" Margin="0,0,0,10"/></Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="{DynamicResource ActionNote}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="180" AutomationProperties.Name="Optional action note"/><TextBlock Text="{DynamicResource ActionNoteHelp}" Foreground="#8792A3" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,10,0"/><Button Content="{DynamicResource SaveAction}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="Save_Click"/></StackPanel>
    </Grid></Grid>
</Window>
