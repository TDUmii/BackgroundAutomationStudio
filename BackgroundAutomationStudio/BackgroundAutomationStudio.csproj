<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <AssemblyName>BackgroundAutomationStudio</AssemblyName>
    <RootNamespace>BackgroundAutomationStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>2.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows.Slim" Version="4.13.0.20260627" ExcludeAssets="analyzers" />
  </ItemGroup>

</Project>
